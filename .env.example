# Copy to .env (gitignored) and fill in real values. Never commit real keys.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lease_db
DB_USERNAME=lease_service
DB_PASSWORD=<your-db-password>

# --- JWT (Project_A_JWT_Authentication_and_Security_Standard.md / AGENTS.md §8) ---
SERVICE_NAME=lease-occupancy-service

# The Gateway's RSA public key (PEM, X.509 SubjectPublicKeyInfo). Verifies every incoming
# Gateway-signed request. Obtain from whoever owns the Gateway; if unset, this service
# generates an ephemeral dev keypair at boot and rejects every real Gateway-signed token.
GATEWAY_JWT_PUBLIC_KEY=<gateway-public-key-pem>

# This service's own RSA private key (PEM, PKCS8). Signs the Service JWT used for outbound
# calls. Register the matching public key with the Gateway. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out service-key.pem
#   openssl pkey -in service-key.pem -pubout -out service-pub.pem
SERVICE_JWT_PRIVATE_KEY=<lease-occupancy-service-private-key-pem>

SERVICE_JWT_EXPIRES_IN_SECONDS=300

# --- Outbound service calls ---
# Base URL of the API Gateway — every outbound inter-service call routes through it,
# never directly to a sibling service.
GATEWAY_URL=http://localhost:8080
